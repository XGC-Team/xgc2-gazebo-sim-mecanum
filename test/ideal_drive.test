<?xml version="1.0"?>
<launch>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <include file="$(find gazebo_sim_mecanum)/launch/spawn.launch">
    <arg name="ns" value="ugv1"/>
    <arg name="model_name" value="ugv1"/>
    <arg name="drive_model" value="ideal"/>
    <arg name="state_publish_rate" value="100.0"/>
    <arg name="visualize_max_freq" value="20.0"/>
  </include>

  <test test-name="ideal_drive_contract" pkg="gazebo_sim_mecanum"
        type="ideal_drive_e2e.py" time-limit="60"/>
</launch>
