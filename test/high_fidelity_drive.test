<?xml version="1.0"?>
<launch>
  <arg name="world_name"/>
  <arg name="simulation_service_ref_json"/>
  <arg name="target_id"/>
  <include file="$(find gazebo_sim_worlds)/launch/native_world.launch">
      <arg name="world" value="$(arg world_name)"/>
      <arg name="paused" value="false"/>
      <arg name="gui" value="false"/>
      <arg name="ros_data" value="true"/>
    </include>

  <include file="$(find gazebo_sim_mecanum)/launch/spawn.launch"><arg name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><arg name="target_id" value="$(arg target_id)"/>
    <arg name="ns" value="ugv1"/>
    <arg name="model_name" value="ugv1"/>
    <arg name="drive_model" value="high_fidelity"/>
    <arg name="state_publish_rate" value="100.0"/>
    <arg name="visualize_max_freq" value="20.0"/>
  </include>

  <test test-name="high_fidelity_drive_contract" pkg="gazebo_sim_mecanum"
        type="high_fidelity_drive_e2e.py" time-limit="90"><param name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><param name="target_id" value="$(arg target_id)"/></test>
</launch>
