<?xml version="1.0"?>
<package format="2">
  <name>gazebo_sim_mecanum</name>
  <version>0.1.0</version>
  <description>Selectable high-fidelity and ideal Mecanum UGV model for Gazebo Classic.</description>

  <maintainer email="dev@xiaokang.ink">XGC2</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>xgc2_gazebo_scene</depend>
  <exec_depend>xgc2_scene_runtime</exec_depend>
  <exec_depend>gazebo_sim_worlds</exec_depend>
  <build_depend>libxgc2-xrpc-dev</build_depend>
  <exec_depend>libxgc2-xrpc1</exec_depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rostest</exec_depend>
  <exec_depend>mecanum_description</exec_depend>
  <test_depend>xgc2_simple_lidar</test_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>tf</test_depend>

  <export>
    <gazebo_ros gazebo_model_path="${prefix}/models" plugin_path="${prefix}/../../lib"/>
  </export>
</package>
