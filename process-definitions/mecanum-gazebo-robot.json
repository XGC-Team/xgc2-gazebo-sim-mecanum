{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "mecanum-gazebo-robot",
      "version": "1.2.0",
      "label": "Mecanum Gazebo robot",
      "description": "One selectable high-fidelity or ideal Mecanum model attached to an existing Gazebo Classic server.",
      "parameters": {
        "groups": [
          {
            "id": "ros-advanced",
            "label": "ROS advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri"
            ]
          }
        ],
        "properties": {
          "gazeboMasterPort": {
            "type": "integer",
            "default": 11345,
            "minimum": 1,
            "maximum": 65535
          },
          "driveModel": {
            "type": "string",
            "description": "Gazebo drive dynamics",
            "enum": [
              "high_fidelity",
              "ideal"
            ],
            "default": "high_fidelity"
          },
          "namespace": {
            "type": "string",
            "description": "Absolute frozen per-robot ROS namespace",
            "default": "/ugv1"
          },
          "targetId": {
            "type": "string",
            "description": "Native service local target identity",
            "default": "core"
          },
          "rosMasterUri": {
            "type": "string",
            "description": "Exact ROS master URI supplied by the completed Experiment world context"
          },
          "launchInput": {
            "type": "json",
            "description": "Frozen Robot and actual completed world ServiceRef for native launch",
            "default": {
              "robot": {},
              "simulationServiceRef": {}
            }
          }
        },
        "required": [
          "rosMasterUri"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc2_simple_lidar/launch_robot.py",
        "args": [
          "--profile",
          "mecanum",
          "--namespace",
          "${namespace}",
          "--target-id",
          "${targetId}",
          "/opt/ros/noetic/share/gazebo_sim_mecanum/launch/spawn.launch",
          "drive_model:=${driveModel}",
          "plugin_filename:=/opt/ros/noetic/lib/libgazebo_sim_mecanum_contract.so",
          "mesh_prefix:=file:///opt/ros/noetic/share/mecanum_description/meshes"
        ],
        "env": {
          "GAZEBO_MASTER_URI": "http://127.0.0.1:${gazeboMasterPort}",
          "ROS_MASTER_URI": "${rosMasterUri}"
        },
        "stdinParameter": "launchInput"
      },
      "setupFiles": [
        "/opt/ros/noetic/setup.bash"
      ],
      "readiness": {
        "kind": "none"
      },
      "stop": {
        "graceMs": 5000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
