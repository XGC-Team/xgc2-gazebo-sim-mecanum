        }
      },
      "beforeStart": {
        "command": {
          "executable": "/usr/bin/python3",
          "args": [
            "-c",
            "import fcntl,json,os,stat,subprocess,sys\nmode=\"strict\"\ntry:\n    rosservice,model,raw_port,mode=sys.argv[1:]\n    if mode not in (\"strict\",\"best-effort\"):\n        raise ValueError(\"invalid Gazebo cleanup mode: \"+mode)\n    uid=os.getuid()\n    port=int(raw_port)\n    lock_path=f\"/tmp/xgc2-gazebo-delete-model-u{uid}-ros-p{port}.lock\"\n    fd=os.open(lock_path,os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,0o600)\n    try:\n        info=os.fstat(fd)\n        if not stat.S_ISREG(info.st_mode) or info.st_uid != uid:\n            raise PermissionError(f\"unsafe Gazebo delete-model lock: {lock_path}\")\n        fcntl.flock(fd,fcntl.LOCK_EX)\n        try:\n            result=subprocess.run([rosservice,\"call\",\"/gazebo/delete_model\",json.dumps({\"model_name\":model},separators=(\",\",\":\"))],timeout=4,check=False)\n        finally:\n            fcntl.flock(fd,fcntl.LOCK_UN)\n    finally:\n        os.close(fd)\n    if result.returncode != 0:\n        raise subprocess.CalledProcessError(result.returncode,result.args)\nexcept BaseException:\n    if mode == \"best-effort\":\n        raise SystemExit(0)\n    raise\n",
