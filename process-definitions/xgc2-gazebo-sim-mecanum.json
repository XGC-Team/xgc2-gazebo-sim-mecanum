{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "mecanum-gazebo-robot",
      "version": "0.2.0",
      "label": "Mecanum Gazebo robot",
      "description": "One selectable high-fidelity or ideal Mecanum model attached to an existing Gazebo Classic server.",
      "drivers": [
        "host"
      ],
      "parameters": {
        "properties": {
          "gazeboMasterPort": {
            "type": "integer",
            "default": 11345,
            "minimum": 1,
            "maximum": 65535
          },
          "driveModel": {
            "type": "string",
            "description": "Gazebo drive dynamics",
            "enum": [
              "high_fidelity",
              "ideal"
            ],
            "default": "high_fidelity"
          },
          "modelName": {
            "type": "string",
            "description": "Unique Gazebo model name",
            "default": "ugv1"
          },
          "namespace": {
            "type": "string",
            "description": "ROS namespace without a leading slash",
            "default": "ugv1"
          },
          "rosMasterPort": {
            "type": "integer",
            "default": 11311,
            "minimum": 1,
            "maximum": 65535
          },
          "spawnX": {
            "type": "number",
            "default": 0
          },
          "spawnY": {
            "type": "number",
            "default": 0
          },
          "spawnYaw": {
            "type": "number",
            "default": 0,
            "minimum": -6.283185307179586,
            "maximum": 6.283185307179586
          },
          "spawnZ": {
            "type": "number",
            "default": 0
          }
        },
        "additionalProperties": false
      },
      "resourceClaims": [
        {
          "bindingKey": "robot",
          "kind": "robot",
          "mode": "",
          "capacity": 0,
          "identityParts": [
            {
              "parameter": "modelName"
            }
          ]
        },
        {
          "bindingKey": "gazebo-model",
          "kind": "custom",
          "mode": "",
          "capacity": 0,
          "namespace": "gazebo-model",
          "identityParts": [
            {
              "parameter": "gazeboMasterPort"
            },
            {
              "parameter": "modelName"
            }
          ]
        },
        {
          "bindingKey": "ros-stack",
          "kind": "custom",
          "mode": "",
          "capacity": 0,
          "namespace": "ros-stack",
          "identityParts": [
            {
              "parameter": "rosMasterPort"
            },
            {
              "parameter": "namespace"
            },
            {
              "literal": "mecanum"
            }
          ]
        }
      ],
      "command": {
        "executable": "/opt/ros/noetic/bin/roslaunch",
        "args": [
          "/opt/ros/noetic/share/gazebo_sim_mecanum/launch/spawn.launch",
          "ns:=${namespace}",
          "model_name:=${modelName}",
          "drive_model:=${driveModel}",
          "x:=${spawnX}",
          "y:=${spawnY}",
          "z:=${spawnZ}",
          "yaw:=${spawnYaw}"
        ],
        "env": {
          "CMAKE_PREFIX_PATH": "/opt/ros/noetic",
          "GAZEBO_MASTER_URI": "http://127.0.0.1:${gazeboMasterPort}",
          "LD_LIBRARY_PATH": "/opt/ros/noetic/lib:/opt/ros/noetic/lib/x86_64-linux-gnu:/opt/ros/noetic/lib/aarch64-linux-gnu",
          "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
          "PKG_CONFIG_PATH": "/opt/ros/noetic/lib/pkgconfig",
          "PYTHONPATH": "/opt/ros/noetic/lib/python3/dist-packages",
          "ROS_DISTRO": "noetic",
          "ROS_ETC_DIR": "/opt/ros/noetic/etc/ros",
          "ROS_MASTER_URI": "http://127.0.0.1:${rosMasterPort}",
          "ROS_PACKAGE_PATH": "/opt/ros/noetic/share",
          "ROS_PYTHON_VERSION": "3",
          "ROS_ROOT": "/opt/ros/noetic/share/ros",
          "ROS_VERSION": "1"
        }
      },
      "beforeStart": {
        "command": {
          "executable": "/opt/ros/noetic/bin/rosservice",
          "args": [
            "call",
            "/gazebo/delete_model",
            "model_name: '${modelName}'"
          ],
          "env": {
            "GAZEBO_MASTER_URI": "http://127.0.0.1:${gazeboMasterPort}",
            "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "PYTHONPATH": "/opt/ros/noetic/lib/python3/dist-packages",
            "ROS_MASTER_URI": "http://127.0.0.1:${rosMasterPort}"
          }
        },
        "timeout": 5000000000
      },
      "beforeStop": {
        "command": {
          "executable": "/opt/ros/noetic/bin/rosservice",
          "args": [
            "call",
            "/gazebo/delete_model",
            "model_name: '${modelName}'"
          ],
          "env": {
            "GAZEBO_MASTER_URI": "http://127.0.0.1:${gazeboMasterPort}",
            "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "PYTHONPATH": "/opt/ros/noetic/lib/python3/dist-packages",
            "ROS_MASTER_URI": "http://127.0.0.1:${rosMasterPort}"
          }
        },
        "timeout": 5000000000
      },
      "readiness": {
        "kind": "exec",
        "command": {
          "executable": "/opt/ros/noetic/lib/gazebo_sim_mecanum/check_model_ready.py",
          "args": [
            "${modelName}"
          ],
          "env": {
            "CMAKE_PREFIX_PATH": "/opt/ros/noetic",
            "LD_LIBRARY_PATH": "/opt/ros/noetic/lib:/opt/ros/noetic/lib/x86_64-linux-gnu:/opt/ros/noetic/lib/aarch64-linux-gnu",
            "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "PKG_CONFIG_PATH": "/opt/ros/noetic/lib/pkgconfig",
            "PYTHONPATH": "/opt/ros/noetic/lib/python3/dist-packages",
            "ROS_DISTRO": "noetic",
            "ROS_ETC_DIR": "/opt/ros/noetic/etc/ros",
            "ROS_MASTER_URI": "http://127.0.0.1:${rosMasterPort}",
            "ROS_PACKAGE_PATH": "/opt/ros/noetic/share",
            "ROS_PYTHON_VERSION": "3",
            "ROS_ROOT": "/opt/ros/noetic/share/ros",
            "ROS_VERSION": "1"
          }
        },
        "interval": 1000000000,
        "timeout": 3000000000,
        "successThreshold": 1,
        "failureThreshold": 10
      },
      "liveness": {
        "kind": "process",
        "interval": 2000000000,
        "timeout": 2000000000,
        "successThreshold": 1,
        "failureThreshold": 3
      },
      "stop": {
        "gracePeriod": 5000000000
      },
      "restart": {
        "mode": "never",
        "maxRestarts": 0,
        "backoff": 0
      },
      "digest": "",
      "internal": false
    },
