<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_namespace" default="ugv1"/>
  <model name="xgc2_mecanum_ugv">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!--
      The model origin is base_footprint at ground level. This link has no
      collision geometry and no gravity. Gazebo owns the velocity integration;
      there is deliberately no wheel/contact dynamics.
    -->
    <link name="base_footprint">
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay>
        <linear>0</linear>
        <angular>0</angular>
      </velocity_decay>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.06</iyy>
          <izz>0.08</izz>
        </inertia>
      </inertial>

      <visual name="base_link">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://xgc2_mecanum_ugv/meshes/nexus_base_link.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.9 0.8 0.6 1</ambient>
          <diffuse>0.9 0.8 0.6 1</diffuse>
        </material>
      </visual>

      <visual name="upper_left_wheel_shaft">
        <pose>0.150 0.108 0.05 0 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/wheel_shaft.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="lower_left_wheel_shaft">
        <pose>-0.150 0.108 0.05 0 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/wheel_shaft.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="upper_right_wheel_shaft">
        <pose>0.150 -0.108 0.05 3.141592653589793 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/wheel_shaft.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="lower_right_wheel_shaft">
        <pose>-0.150 -0.108 0.05 3.141592653589793 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/wheel_shaft.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>

      <visual name="upper_left_wheel">
        <pose>0.150 0.150 0.05 0 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/mecanum_wheel_left.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
      <visual name="lower_left_wheel">
        <pose>-0.150 0.150 0.05 0 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/mecanum_wheel_right.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
      <visual name="upper_right_wheel">
        <pose>0.150 -0.150 0.05 3.141592653589793 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/mecanum_wheel_right.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
      <visual name="lower_right_wheel">
        <pose>-0.150 -0.150 0.05 3.141592653589793 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/mecanum_wheel_left.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>

      <visual name="front_sensor">
        <pose>0.205 0 0.06 1.570796326794897 0 0</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/urm04.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="left_sensor">
        <pose>0 0.108 0.06 1.570796326794897 0 1.570796326794897</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/urm04.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="right_sensor">
        <pose>0 -0.108 0.06 1.570796326794897 0 -1.570796326794897</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/urm04.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="rear_sensor">
        <pose>-0.201 0 0.06 1.570796326794897 0 3.141592653589793</pose>
        <geometry><mesh><uri>model://xgc2_mecanum_ugv/meshes/urm04.STL</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="stereo_camera">
        <pose>0.205 0 0.06 0 0 0</pose>
        <geometry><box><size>0.02 0.08 0.01</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <!-- Set ideal velocity and publish the ROS contract; Gazebo integrates pose. -->
    <plugin name="mecanum_contract" filename="libgazebo_sim_mecanum_contract.so">
      <robotNamespace>$(arg robot_namespace)</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <poseTopic>pose</poseTopic>
      <twistTopic>twist</twistTopic>
      <imuTopic>imu</imuTopic>
      <jointStatesTopic>joint_states</jointStatesTopic>
      <statePublishRate>100</statePublishRate>
      <visualPublishRate>20</visualPublishRate>
      <maxFrontVelocity>1.5</maxFrontVelocity>
      <maxLeftVelocity>1.5</maxLeftVelocity>
      <maxYawVelocity>1.570796326794897</maxYawVelocity>
      <linearScale>1</linearScale>
      <angularScale>1</angularScale>
      <imuYawBase>0.7853981633974483</imuYawBase>
      <useImuOrientation>false</useImuOrientation>
      <mapFrame>map</mapFrame>
      <imuFrame>world</imuFrame>
      <baseFrame>base_footprint</baseFrame>
    </plugin>
  </model>
</sdf>
