<?xml version="1.0"?>
<launch>
  <arg name="simulation_service_ref_json"/>
  <arg name="target_id"/>
  <arg name="ns" default="ugv1"/>
  <arg name="model_name" default="$(arg ns)"/>
  <arg name="drive_model" default="high_fidelity"/>
  <arg name="enable_simple_lidar" default="false"/>
  <arg name="simple_lidar_pose" default="0 0 0.28 0 0 0"/>
  <arg name="simple_lidar_acceleration" default="gpu"/>
  <arg name="simple_lidar_rate_hz" default="10"/>
  <arg name="simple_lidar_range_meters" default="20"/>
  <arg name="simple_lidar_hfov_deg" default="360"/>
  <arg name="simple_lidar_vfov_deg" default="57.29577951308232"/>
  <arg name="simple_lidar_hres" default="360"/>
  <arg name="simple_lidar_vres" default="16"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="v_front_max_m_s" default="1.5"/>
  <arg name="v_left_max_m_s" default="1.5"/>
  <arg name="omega_max_deg_s" default="90.0"/>
  <arg name="linear_vel_scale" default="1.0"/>
  <arg name="angular_vel_scale" default="1.0"/>
  <arg name="use_imu_orientation" default="false"/>
  <arg name="state_publish_rate" default="100.0"/>
  <arg name="visualize_max_freq" default="20.0"/>
  <arg name="imu_publish_rate" default="20.0"/>
  <arg name="battery_voltage" default="12.348"/>
  <arg name="power_voltage_publish_rate" default="1"/>
  <arg name="plugin_filename" default="libgazebo_sim_mecanum_contract.so"/>
  <arg name="mesh_prefix" default="model://mecanum_description/meshes"/>

  <group ns="$(arg ns)">
    <param name="v_front_max_m_s" value="$(arg v_front_max_m_s)"/>
    <param name="v_left_max_m_s" value="$(arg v_left_max_m_s)"/>
    <param name="omega_max_deg_s" value="$(arg omega_max_deg_s)"/>
    <param name="linear_vel_scale" value="$(arg linear_vel_scale)"/>
    <param name="angular_vel_scale" value="$(arg angular_vel_scale)"/>
    <param name="use_imu_orientation" value="$(arg use_imu_orientation)"/>
    <param name="state_publish_rate" value="$(arg state_publish_rate)"/>
    <param name="visualize_max_freq" value="$(arg visualize_max_freq)"/>
    <param name="imu_publish_rate" type="double" value="$(arg imu_publish_rate)"/>
    <param name="battery_voltage" type="double" value="$(arg battery_voltage)"/>
    <param name="power_voltage_publish_rate" type="double" value="$(arg power_voltage_publish_rate)"/>
  </group>

  <param name="/$(arg ns)/gazebo_model_sdf"
         command="$(find xacro)/xacro $(dirname)/../models/xgc2_mecanum_ugv/model.sdf.xacro chassis_robot_id:=$(arg model_name) robot_namespace:=$(arg ns) drive_model:=$(arg drive_model) plugin_filename:=$(arg plugin_filename) mesh_prefix:=$(arg mesh_prefix) enable_simple_lidar:=$(arg enable_simple_lidar) simple_lidar_pose:='$(arg simple_lidar_pose)' simple_lidar_acceleration:=$(arg simple_lidar_acceleration) simple_lidar_rate_hz:=$(arg simple_lidar_rate_hz) simple_lidar_range_meters:=$(arg simple_lidar_range_meters) simple_lidar_hfov_deg:=$(arg simple_lidar_hfov_deg) simple_lidar_vfov_deg:=$(arg simple_lidar_vfov_deg) simple_lidar_hres:=$(arg simple_lidar_hres) simple_lidar_vres:=$(arg simple_lidar_vres)"/>
  <node pkg="xgc2_gazebo_scene" type="spawn_robot_model"
        name="spawn_$(arg model_name)" output="screen"
        args="-sdf -param /$(arg ns)/gazebo_model_sdf
              -model $(arg model_name)
              -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw) -simulation_service_ref_json '$(arg simulation_service_ref_json)' -target_id $(arg target_id) -robot_namespace /$(arg ns)"/>
</launch>
